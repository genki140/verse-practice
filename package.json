{
  "name": "verse-practice",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "content:validate": "tsx scripts/validate.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "npm run content:validate && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
